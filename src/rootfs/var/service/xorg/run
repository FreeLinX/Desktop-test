#!/bin/sh
# FreeLinX X11 desktop: start Xorg on /dev/fb0, then openbox.
mkdir -p /tmp/.X11-unix /var/lib/xkb 2>/dev/null || true
chmod 1777 /tmp/.X11-unix 2>/dev/null || true

# Kill any leftover Xorg/openbox from a previous runit cycle so the new
# service never fights stale processes (lock, WM, or device handles).
for p in /proc/[0-9]*; do
    [ -r "$p/cmdline" ] || continue
    cmd=$(tr '\0' ' ' < "$p/cmdline" 2>/dev/null) || continue
    case "$cmd" in
        *"Xorg"*|*"openbox"*) kill -9 "${p#/proc/}" 2>/dev/null || true ;;
    esac
done

# Never let a previous incarnation hold the display lock.
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0

# Map the QEMU PS/2 evdev nodes to the stable inodes /dev/fl-kbd and
# /dev/fl-pointer used by the flinput X input driver.
NAME=""
HANDLER=""
fl_decide() {
    case "$NAME" in
        *[Kk]eyboard*) ln -sf "/dev/input/$HANDLER" /dev/fl-kbd ;;
        *[Mm]ouse*|*[Ee]xplorer*) ln -sf "/dev/input/$HANDLER" /dev/fl-pointer ;;
    esac
}
while IFS= read -r l; do
    case "$l" in
        'I:'*) fl_decide; NAME=""; HANDLER="" ;;
        'Handler='*) HANDLER="${l#Handler=}"; HANDLER="${HANDLER%% *}" ;;
        'Name="'*) NAME="${l#Name=\"}"; NAME="${NAME%\"}" ;;
    esac
done < /proc/bus/input/devices
fl_decide
if [ ! -e /dev/fl-kbd ]; then ln -sf /dev/input/event1 /dev/fl-kbd; fi
if [ ! -e /dev/fl-pointer ]; then ln -sf /dev/input/event2 /dev/fl-pointer; fi

Xorg -config /etc/X11/xorg.conf -noreset -nolisten tcp -logfile /tmp/xorg.log > /dev/ttyS0 2>&1 &
XPID=$!

i=0
while [ ! -e /tmp/.X11-unix/X0 ] && [ "$i" -lt 300 ]; do
    sleep 0.1
    i=$((i+1))
done

if [ ! -e /tmp/.X11-unix/X0 ] && ! kill -0 "$XPID" 2>/dev/null; then
    echo "Xorg failed to start on :0" > /dev/ttyS0
    exit 1
fi

export DISPLAY=:0
export XDG_CONFIG_HOME=/root/.config
export XDG_DATA_HOME=/root/.local/share
export XDG_CACHE_HOME=/root/.cache
export XDG_DATA_DIRS=/usr/share/X11/xtree/share:/usr/local/share:/usr/share
mkdir -p "$XDG_CONFIG_HOME/openbox"

# Run the desktop shell alongside; the service lives as long as Xorg.
( exec openbox-session ) &
wait "$XPID"
exit 0